
# ---- Required ----
# Fill these automatically with:  scripts/init-env.sh
#
# Signs login tokens; shared by all services. Services refuse to start if this
# is missing, shorter than 32 characters, or still a "change-me" placeholder.
JWT_SECRET=

# Each service logs in to Postgres as its own least-privilege role.
# 16+ random characters each; use hex (it goes into a connection URL).
AUTH_DB_PASSWORD=
HABIT_DB_PASSWORD=
TRACKING_DB_PASSWORD=
ANALYTICS_DB_PASSWORD=
SOCIAL_DB_PASSWORD=
REMINDER_DB_PASSWORD=

# ---- Reminders (optional) ----
# Public address of this app, as your phone reaches it. When set, ntfy
# reminders get "Snooze 30 min" / "Snooze 1 h" buttons.
# PUBLIC_URL=https://habits.example.com

# ---- AWS serverless deploy (scripts/deploy-aws.sh) ----
# Owner/admin connection URL of your cloud Postgres (e.g. Neon), used only to
# run migrations. The services themselves connect as their own roles.
# AWS_DB_ADMIN_URL=postgresql://owner:password@ep-example.aws.neon.tech/openhabit?sslmode=require

# ---- OIDC / SSO (optional; leave blank to disable "Sign in with SSO") ----
# OIDC_ISSUER=https://auth.example.com
# OIDC_CLIENT_ID=openhabit
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URI=https://habits.example.com/api/auth/oidc/callback
# OIDC_POST_LOGIN_URI=https://habits.example.com/
# OIDC_PROVIDER_NAME=Home SSO
# ALLOW_REGISTRATION=false   # recommended for SSO-only instances

# ---- Backups ----
# BACKUP_KEEP=14             # nightly dumps to keep (compose `backup` service)

# ---- Observability (compose --profile monitoring) ----
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=change-me
