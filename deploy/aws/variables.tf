variable "region" {
  description = "AWS region for the Lambdas, API and bucket (ap-south-1 = Mumbai)."
  type        = string
  default     = "ap-south-1"
}

variable "name" {
  description = "Prefix for every resource name."
  type        = string
  default     = "openhabit"
}

variable "tags" {
  description = "Tags on every resource."
  type        = map(string)
  default     = { app = "openhabit" }
}

variable "tag_event_rule" {
  description = "Tag the reminder EventBridge rule too; false for accounts that deny events:TagResource (e.g. sandboxes)."
  type        = bool
  default     = true
}

# ---- database: any Postgres reachable over the internet with TLS -------------
# (Neon, Supabase, Aiven, Crunchy Bridge, …), or a small public RDS instance
# created here (create_database). Keeping the Lambdas outside a VPC means no
# NAT gateway, so idle cost stays near zero.

variable "create_database" {
  description = "Create a small private RDS Postgres (Lambdas join the default VPC; no internet egress, so no ntfy pushes) instead of using db_host. For sandboxes and testing."
  type        = bool
  default     = false
}

variable "nat_mode" {
  description = "With create_database: internet access for the VPC functions (ntfy pushes, webhooks, SSO). \"none\", \"gateway\" (managed NAT gateway, ~$32+/month) or \"instance\" (a t3.micro NAT instance, ~$8/month, no Elastic IP needed)."
  type        = string
  default     = "none"

  validation {
    condition     = contains(["none", "gateway", "instance"], var.nat_mode)
    error_message = "nat_mode must be none, gateway or instance."
  }
}

variable "db_instance_class" {
  type    = string
  default = "db.t4g.micro"
}

variable "db_admin_password" {
  description = "Master password for the RDS instance (create_database only)."
  type        = string
  default     = ""
  sensitive   = true
}

variable "db_host" {
  description = "External Postgres host (when create_database is false). With Neon, use the pooled host (\"-pooler\" in the name)."
  type        = string
  default     = ""
}

variable "db_admin_url" {
  description = "Owner/admin connection URL of the external Postgres, used by the migrate Lambda. Empty = skip migrations (run them yourself)."
  type        = string
  default     = ""
  sensitive   = true
}

variable "db_port" {
  type    = number
  default = 5432
}

variable "db_name" {
  type    = string
  default = "openhabit"
}

variable "db_sslmode" {
  description = "sslmode for the service connections (node-postgres verifies the certificate for require/verify-full; Lambda trusts the RDS CAs)."
  type        = string
  default     = "verify-full"
}

variable "db_passwords" {
  description = "Password per service role (auth, habit, tracking, analytics, social, reminder) — the *_DB_PASSWORD values from .env. scripts/deploy-aws.sh passes them in."
  type        = map(string)
  sensitive   = true

  validation {
    condition = alltrue([
      for svc in ["auth", "habit", "tracking", "analytics", "social", "reminder"] :
      length(lookup(var.db_passwords, svc, "")) >= 16
    ])
    error_message = "db_passwords needs a 16+ character entry for each of: auth, habit, tracking, analytics, social, reminder."
  }
}

variable "jwt_secret" {
  description = "Shared JWT secret (JWT_SECRET from .env), at least 32 characters."
  type        = string
  sensitive   = true

  validation {
    condition     = length(var.jwt_secret) >= 32 && !strcontains(lower(var.jwt_secret), "change-me")
    error_message = "jwt_secret must be at least 32 random characters."
  }
}

# ---- app settings -------------------------------------------------------------

variable "public_url" {
  description = "Public address of the app if you put a custom domain in front; empty = the CloudFront URL."
  type        = string
  default     = ""
}

variable "allow_registration" {
  description = "Allow new sign-ups. Turn off once your accounts exist."
  type        = bool
  default     = true
}

variable "oidc" {
  description = "Optional OIDC single sign-on (Cognito, Authentik, Keycloak, Google, ...). Leave issuer empty to disable."
  type = object({
    issuer        = string
    client_id     = string
    client_secret = string
    provider_name = string
  })
  default = {
    issuer        = ""
    client_id     = ""
    client_secret = ""
    provider_name = "SSO"
  }
  sensitive = true
}

variable "vapid" {
  description = "Web Push key pair (VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY from .env, generated by scripts/init-env.sh). Empty = Web Push off."
  type = object({
    public_key  = string
    private_key = string
    subject     = string
  })
  default   = { public_key = "", private_key = "", subject = "" }
  sensitive = true
}

variable "reminder_interval_minutes" {
  description = "How often the EventBridge rule runs the reminder check (1-15). Each run queries Postgres, so a short interval keeps a scale-to-zero database awake."
  type        = number
  default     = 5

  validation {
    condition     = var.reminder_interval_minutes >= 1 && var.reminder_interval_minutes <= 15
    error_message = "reminder_interval_minutes must be between 1 and 15."
  }
}

# ---- runtime and cost guards ----------------------------------------------------

variable "enable_cdn" {
  description = "Serve the frontend from S3 + CloudFront. When false (e.g. accounts without CloudFront), a Lambda serves it behind the same HTTP API."
  type        = bool
  default     = true
}

variable "use_managed_iam_policies" {
  description = "Attach AWS's managed Lambda policies instead of the tighter inline ones, for accounts that deny iam:PutRolePolicy (e.g. sandboxes)."
  type        = bool
  default     = false
}

variable "lambda_role_name" {
  description = "Name of the functions' IAM role; empty = \"<name>-lambda\". Sandboxes may only allow iam:PassRole on fixed names (KodeKloud: lambda_execution_role)."
  type        = string
  default     = ""
}

variable "lambda_architecture" {
  type    = string
  default = "arm64"
}

variable "lambda_memory_mb" {
  type    = number
  default = 256
}

variable "lambda_timeout" {
  description = "Seconds per invocation for every function (requests and reminder runs finish in well under a second)."
  type        = number
  default     = 10
}

variable "log_retention_days" {
  description = "Days to keep Lambda logs; 0 = never expire (for sandboxes that deny logs:PutRetentionPolicy)."
  type        = number
  default     = 14
}

variable "api_throttle_rate" {
  description = "Steady-state API requests per second (caps the bill if someone hammers the API)."
  type        = number
  default     = 20
}

variable "api_throttle_burst" {
  type    = number
  default = 50
}

variable "cloudfront_price_class" {
  description = "PriceClass_100 = NA/EU edges only (cheapest); PriceClass_200 adds Asia incl. India."
  type        = string
  default     = "PriceClass_200"
}

# ---- email (password reset, address verification) --------------------------------

variable "mail" {
  description = "Outgoing email for password-reset and verification links. transport: smtp (Amazon SES SMTP, Mailgun, ...), webhook, log or empty (= off). Links use the app's public URL (set public_url when it is not the default)."
  type = object({
    transport   = string
    from        = string
    smtp_url    = string # smtp://user:pass@host:587 (a secret)
    webhook_url = string
  })
  default   = { transport = "", from = "", smtp_url = "", webhook_url = "" }
  sensitive = true
}

variable "require_email_verification" {
  description = "Refuse sign-in until the address is confirmed (needs mail)."
  type        = bool
  default     = false
}

# ---- secrets ----------------------------------------------------------------------

variable "use_secrets_manager" {
  description = "Keep JWT_SECRET, database URLs/passwords, VAPID private key, OIDC client secret and SMTP URL in one AWS Secrets Manager secret that the functions read at start-up, instead of in their plain-text environment. The functions' role gets read access to that secret only. Costs about $0.40 per month. Not available in sandboxes that deny secretsmanager:*."
  type        = bool
  default     = false
}

variable "secret_name" {
  description = "Name of the Secrets Manager secret (use_secrets_manager)."
  type        = string
  default     = ""
}
