# Copy to terraform.tfvars (gitignored) and fill in. Secrets — jwt_secret and
# db_passwords — come from .env via scripts/deploy-aws.sh; don't put them here.

region = "ap-south-1"

# Postgres reachable over TLS, e.g. Neon's pooled host:
db_host = "ep-example-123456-pooler.ap-southeast-1.aws.neon.tech"
db_name = "openhabit"

# allow_registration        = false   # once your accounts exist
# reminder_interval_minutes = 5       # 1-15; see README for the database cost trade-off
# public_url                = "https://habits.example.com"   # if you add a custom domain

# Restricted sandboxes (tested on the KodeKloud AWS playground, which denies
# CloudFront, EventBridge Scheduler, inline IAM policies, log retention, rule
# tagging and iam:PassRole except on fixed role names):
# create_database          = true                     # private RDS; Lambdas join the default VPC
# nat_mode                 = "instance"               # internet for ntfy pushes (the playground releases Elastic IPs, so no NAT gateway)
# db_admin_password        = "<16+ random chars>"     # better: export TF_VAR_db_admin_password
# db_instance_class        = "db.t4g.micro"
# enable_cdn               = false                    # a Lambda serves the frontend
# use_managed_iam_policies = true
# lambda_role_name         = "lambda_execution_role"
# log_retention_days       = 0
# tag_event_rule           = false
# region                   = "us-east-1"

# Optional SSO, e.g. Amazon Cognito or any OIDC provider:
# oidc = {
#   issuer        = "https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_XXXXXXX"
#   client_id     = "xxxxxxxx"
#   client_secret = "xxxxxxxx"
#   provider_name = "Cognito"
# }

# KodeKloud playground: its compliance sweep deletes any Lambda named "*-tracking" within minutes.
# function_names = { tracking = "openhabit-entries" }
